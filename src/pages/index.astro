---
// ==========================================
// PÁGINA PRINCIPAL: index.astro
// ==========================================

// Importamos el Layout base con HTML y fondo de cuadrícula
import Layout from '../layouts/Layout.astro';

// Importamos el componente de la barra de navegación superior
import Navbar from '../components/Navbar.astro';

// Importamos el componente de la sección principal (Hero + Pilares)
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<!-- Renderizamos la página envuelta en el Layout base -->
<Layout title="Codeva Studio | Ingeniería de Software & Arquitectura de Alto Rendimiento">
    
    <!-- Barra de navegación fija -->
    <Navbar />

    <!-- Contenido principal -->
    <main>
        <Hero />
        <Pillars />
        <Services />
        <Contact />
        <Footer />
    </main>

</Layout>