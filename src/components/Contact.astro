<!-- Sección principal de Contacto -->
<section id="contacto" class="relative z-10 max-w-[92rem] mx-auto w-full px-6 sm:px-10 lg:px-16 py-24">

    <!-- Encabezado de la sección -->
    <div class="flex flex-col items-center text-center mb-16">

        <!-- Badge representativo de la sección -->
        <div class="section-badge mb-4">
            <span>Trabajemos juntos // Codeva Studio</span>
        </div>

        <!-- Título principal -->
        <h2 class="section-title">
            ¿Tienes un proyecto en mente? Hagámoslo realidad
        </h2>

        <!-- Párrafo descriptivo -->
        <p class="section-desc">
           Cuéntanos sobre tu idea o las necesidades tecnológicas de tu empresa. Te respondemos en menos de 24 horas con una propuesta clara.
        </p>

    </div>

    <!-- Grilla principal: Información + Formulario -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start max-w-6xl mx-auto">

        <!-- Columna Izquierda: Tarjeta de Información -->
        <div class="lg:col-span-5 flex flex-col gap-6">

            <!-- Tarjeta base de información -->
            <div class="card-base flex flex-col gap-6">

                <!-- Encabezado de la tarjeta -->
                <h3 class="text-xl font-bold text-white tracking-tight mb-2">
                    Información de Contacto
                </h3>

                <!-- Descripción de la tarjeta -->
                <p class="text-slate-400 text-sm leading-relaxed">
                    Estamos listos para transformar tu idea en software de alto impacto. Elige el canal que prefieras y conversemos hoy mismo.
                </p>

                <!-- Canal: Correo Electrónico -->
                <div class="flex items-start gap-4 pt-4 border-t border-slate-800/80">

                    <!-- Icono de correo -->
                    <div class="icon-box-sm text-accent-400">

                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>

                    </div>

                    <!-- Contenedor de texto del correo -->
                    <div>

                        <!-- Etiqueta Email -->
                        <span class="block text-xs font-mono text-slate-500 uppercase">Email</span>

                        <!-- Enlace del correo -->
                        <a href="mailto:codevastudio.dev@gmail.com" class="text-sm font-semibold text-slate-200 hover:text-accent-400 transition-colors">
                            codevastudio.dev@gmail.com
                        </a>

                    </div>

                </div>

                <!-- Canal: Teléfono & WhatsApp -->
                <div class="flex items-start gap-4 pt-4 border-t border-slate-800/80">

                    <!-- Icono de teléfono -->
                    <div class="icon-box-sm text-emerald-400">

                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>

                    </div>

                    <!-- Contenedor de texto de teléfono -->
                    <div>

                        <!-- Etiqueta Teléfono -->
                        <span class="block text-xs font-mono text-slate-500 uppercase">Teléfono & WhatsApp</span>

                        <!-- Enlace de WhatsApp -->
                        <a
                            href="https://wa.me/527205568820?text=%C2%A1Hola%2C%20equipo%20de%20Codeva%20Studio%21%20Estuve%20revisando%20su%20sitio%20web%20y%20me%20gustar%C3%ADa%20platicar%20con%20ustedes%20sobre%20un%20proyecto%20de%20software%20que%20quiero%20desarrollar.%20%C2%BFTienen%20disponibilidad%3F"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-semibold text-slate-200 hover:text-emerald-400 transition-colors flex items-center gap-1.5"
                        >
                            +52 720 556 8820
                        </a>

                    </div>

                </div>

                <!-- Canal: Modalidad de Trabajo -->
                <div class="flex items-start gap-4 pt-4 border-t border-slate-800/80">

                    <!-- Icono de modalidad -->
                    <div class="icon-box-sm text-accent-400">

                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s-1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                        </svg>

                    </div>

                    <!-- Contenedor de texto de modalidad -->
                    <div>

                        <!-- Etiqueta Modalidad -->
                        <span class="block text-xs font-mono text-slate-500 uppercase">Modalidad</span>

                        <!-- Texto de modalidad -->
                        <span class="text-sm font-semibold text-slate-200">
                            Remoto / Desarrollo Global
                        </span>

                    </div>

                </div>

                <!-- Estado de Disponibilidad -->
                <div class="flex items-center gap-3 pt-4 border-t border-slate-800/80">

                    <!-- Punto de disponible -->
                    <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>

                    <!-- Texto de disponible -->
                    <span class="text-xs font-mono text-emerald-400 font-medium">
                        Disponible para nuevos proyectos
                    </span>

                </div>

            </div>

        </div>

        <!-- Columna Derecha: Formulario -->
        <div class="lg:col-span-7">

            <!-- Formulario de contacto -->
            <form name="contacto-codeva" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="card-base flex flex-col gap-6">

                <!-- Campo oculto para Netlify -->
                <input type="hidden" name="form-name" value="contacto-codeva" />

                <!-- Campo: Nombre -->
                <div class="flex flex-col gap-2">

                    <!-- Etiqueta Nombre -->
                    <label for="name" class="text-xs font-mono text-slate-300 uppercase tracking-wider">
                        Nombre Completo
                    </label>

                    <!-- Input Nombre -->
                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Ej. Carlos Mendoza"
                        required
                        class="form-input"
                    />

                </div>

                <!-- Campo: Correo Electrónico -->
                <div class="flex flex-col gap-2">

                    <!-- Etiqueta Correo -->
                    <label for="email" class="text-xs font-mono text-slate-300 uppercase tracking-wider">
                        Correo Electrónico
                    </label>

                    <!-- Input Correo -->
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="carlos@tuempresa.com"
                        required
                        class="form-input"
                    />

                </div>

                <!-- Campo: Mensaje -->
                <div class="flex flex-col gap-2">

                    <!-- Etiqueta Mensaje -->
                    <label for="message" class="text-xs font-mono text-slate-300 uppercase tracking-wider">
                        Detalles del Proyecto
                    </label>

                    <!-- Textarea Mensaje -->
                    <textarea
                        id="message"
                        name="message"
                        rows="4"
                        placeholder="Cuéntanos sobre tu idea, alcance del proyecto o tecnología que necesitas..."
                        required
                        class="form-input resize-none"
                    ></textarea>

                </div>

                <!-- Mensaje de éxito -->
                <div id="form-status" class="hidden p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono text-center">
                    ¡Mensaje enviado con éxito! Nos pondremos en contacto pronto.
                </div>

                <!-- Botón de Envío -->
                <button
                    type="submit"
                    id="submit-btn"
                    class="w-full py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-indigo-600 via-accent-600 to-indigo-600 hover:opacity-90 transition-all duration-300 shadow-[0_0_25px_rgba(124,58,237,0.3)] hover:shadow-[0_0_35px_rgba(124,58,237,0.5)] text-sm mt-2"
                >
                    Enviar Mensaje
                </button>

            </form>

        </div>

    </div>

</section>