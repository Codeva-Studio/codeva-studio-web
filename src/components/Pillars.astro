---
// Importamos el componente de tarjeta de pilar
import PillarCard from '../components/cards/PillarCard.astro';

// Importamos los datos de los pilares
import { pillars } from "../data/pillars.js";
---

<!-- Sección principal de Pilares -->
<section id="pilares" class="relative z-10 max-w-[92rem] mx-auto w-full px-6 sm:px-10 lg:px-16 py-24">

    <!-- Encabezado de la sección -->
    <div class="flex flex-col items-center text-center mb-16">

        <!-- Badge representativo de la sección -->
        <div class="section-badge mb-4">
            <span>Nuestros Pilares // Codeva Studio</span>
        </div>

        <!-- Título principal -->
        <h2 class="section-title">
            Los cimientos de lo que hacemos
        </h2>

        <!-- Párrafo descriptivo -->
        <p class="section-desc">
            Nuestros principios de trabajo para asegurar que el software que desarrollamos aporte valor real a tu negocio.
        </p>

    </div>

    <!-- Grilla de tarjetas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">

        <!-- Renderizamos una tarjeta por cada pilar definido -->
        {
            pillars.map((pillar) => (
                <PillarCard
                    title={pillar.title}
                    description={pillar.description}
                    iconPath={pillar.iconPath}
                />
            ))
        }

    </div>
    
</section>
