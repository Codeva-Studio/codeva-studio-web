---
// Importamos el componente de tarjeta de servicio
import ServiceCard from '../components/cards/ServiceCard.astro';

// Importamos los datos de los servicios
import { services } from "../data/services.js";
---

<!-- Sección principal de Servicios -->
<section id="servicios" class="relative z-10 max-w-[92rem] mx-auto w-full px-6 sm:px-10 lg:px-16 py-24">

    <!-- Encabezado de la sección -->
    <div class="flex flex-col items-center text-center mb-16">

        <!-- Badge representativo de la sección -->
        <div class="section-badge mb-4">
            <span>Lo que construimos // Codeva Studio</span>
        </div>

        <!-- Título principal -->
        <h2 class="section-title">
            Soluciones tecnológicas adaptadas a tu negocio
        </h2>

        <!-- Párrafo descriptivo -->
        <p class="section-desc">
            Desde el diseño de la arquitectura hasta el desarrollo e implementación. Creamos software a la medida enfocado en rendimiento, estabilidad y valor real.
        </p>

    </div>

    <!-- Grilla de tarjetas de servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">

        <!-- Renderizamos una tarjeta por cada servicio definido -->
        {
            services.map((service) => (
                <ServiceCard
                    title={service.title}
                    description={service.description}
                    technologies={service.technologies}
                    iconPath={service.iconPath}
                >
                </ServiceCard>
            ))
        }
        
    </div>

</section>
