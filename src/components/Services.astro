---
// ==========================================
// COMPONENTE: Services.astro
// ==========================================
// Sección de servicios y tecnologías de Codeva Studio (Enfoque Especializado - 4 Tarjetas)

import ServiceCard from '../components/ServiceCard.astro';

// Datos estructurados con el stack especializado en 4 áreas
const servicesData = [
    {
        title: "Desarrollo Desktop",
        description: "Desarrollo de software nativo y de alto rendimiento para entornos de escritorio, garantizando estabilidad y control total del hardware.",
        technologies: ["Java", "JavaFX"],
        iconSvg: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
    },
    {
        title: "Desarrollo Móvil",
        description: "Creación de aplicaciones móviles modernas, fluidas y optimizadas para ofrecer una experiencia de usuario sobresaliente en dispositivos portátiles.",
        technologies: ["Kotlin", "Java"],
        iconSvg: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
    },
    {
        title: "Desarrollo Web",
        description: "Construcción de interfaces web ultra rápidas, modernas y adaptables con un enfoque estricto en rendimiento y componentes modulares.",
        technologies: ["Astro", "Tailwind CSS", "HTML", "CSS", "JavaScript"],
        iconSvg: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
    },
    {
        title: "Backend & Bases de Datos",
        description: "Diseño de arquitecturas de servidor sólidas, lógica de negocio eficiente y gestión segura de datos escalables.",
        technologies: ["Node.js", "MySQL", "Supabase"],
        iconSvg: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"
    }
];
---

<!-- Sección principal de Servicios -->
<!--
    Contexto de clases de Tailwind CSS:
    - relative: Posicionamiento relativo
    - z-10: Asegura la capa visual sobre el fondo
    - max-w-[92rem]: Ancho máximo controlado y consistente con el resto de la web
    - mx-auto: Centrado horizontal
    - px-6 sm:px-10 lg:px-16: Márgenes laterales responsivos
    - py-24: Espacio vertical amplio
-->
<section id="servicios" class="relative z-10 max-w-[92rem] mx-auto w-full px-6 sm:px-10 lg:px-16 py-24">
    
    <!-- Encabezado de la Sección -->
    <div class="flex flex-col items-center text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-slate-900/80 border border-slate-800 text-purple-400 font-mono text-xs mb-4 shadow-sm">
            <span>Core Services // Codeva Studio</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
            Soluciones Tecnológicas a tu Medida
        </h2>
        <p class="text-base sm:text-lg text-slate-400 max-w-2xl font-normal leading-relaxed">
            Combinamos ingeniería avanzada y un stack tecnológico versátil para convertir ideas complejas en productos digitales sólidos.
        </p>
    </div>

    <!-- Grilla de Servicios (4 columnas en pantallas grandes) -->
    <!--
        Contexto de clases de Tailwind CSS:
        - grid: Sistema de cuadrícula
        - grid-cols-1: 1 columna en móviles
        - md:grid-cols-2: 2 columnas en tablets
        - lg:grid-cols-4: 4 columnas simétricas en pantallas grandes para alojar las 4 especialidades
        - gap-6 lg:gap-8: Espacio simétrico entre tarjetas
    -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {
            servicesData.map((service) => (
                <ServiceCard 
                    title={service.title} 
                    description={service.description}
                    technologies={service.technologies}
                >
                    <svg slot="icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.iconSvg}></path>
                    </svg>
                </ServiceCard>
            ))
        }
    </div>
</section>