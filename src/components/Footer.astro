---
// Importar las redes sociales desde data
import { socialLinks } from "../data/socialLinks";

// Año actual para el copyright
const currentYear = new Date().getFullYear();

---

<!-- Pie de Página -->
<footer class="relative z-10 border-t border-slate-800/80 bg-slate-950/90 backdrop-blur-md text-slate-400 font-normal">

    <!-- Contenedor Principal -->
    <div class="max-w-[92rem] mx-auto px-6 sm:px-10 lg:px-16 py-16">

        <!-- Bloque Superior -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start pb-12 border-b border-slate-800/60">

            <!-- Columna 1: Brand & Logo -->
            <div class="lg:col-span-5 flex flex-col items-start gap-4">

                <!-- Logo + Nombre -->
                <div class="flex items-center gap-3">

                    <!-- Logo -->
                    <div class="w-12 h-12 rounded-xl bg-slate-900 border border-slate-800 p-1.5 flex items-center justify-center shrink-0 shadow-inner overflow-hidden">

                        <img
                            src="/logo.png"
                            alt="Codeva Studio Logo"
                            class="w-full h-full object-contain"
                        />

                    </div>

                    <!-- Nombre del estudio -->
                    <a href="#inicio" class="text-white font-bold text-xl tracking-tight hover:text-accent-400 transition-colors">
                        <span class="text-accent-500 font-mono">&lt;</span>CodevaStudio<span class="text-accent-500 font-mono">/&gt;</span>
                    </a>

                </div>

                <!-- Descripción del estudio -->
                <p class="text-xs text-slate-400 max-w-sm leading-relaxed">
                    Estudio de ingeniería y desarrollo de software. Creamos plataformas escalables, sistemas web de alto rendimiento y soluciones digitales a la medida.
                </p>

                <!-- Indicador de disponibilidad -->
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900/80 border border-slate-800/80 text-[11px] font-mono text-emerald-400 mt-1">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Disponible para nuevos proyectos</span>
                </div>

            </div>

            <!-- Columna 2: Navegación Rápida -->
            <div class="lg:col-span-3 flex flex-col gap-3">

                <!-- Título Navegación -->
                <span class="text-xs font-mono uppercase text-slate-200 tracking-wider font-semibold">Navegación</span>

                <!-- Links de navegación -->
                <nav class="flex flex-col gap-2 text-xs font-mono text-slate-400">
                    <a href="#inicio" class="hover:text-accent-400 transition-colors inline-block">// 01. Inicio</a>
                    <a href="#pilares" class="hover:text-accent-400 transition-colors inline-block">// 02. Pilares</a>
                    <a href="#servicios" class="hover:text-accent-400 transition-colors inline-block">// 03. Servicios</a>
                    <a href="#proyectos" class="hover:text-accent-400 transition-colors inline-block">// 04. Proyectos</a>
                    <a href="#contacto" class="hover:text-accent-400 transition-colors inline-block">// 05. Contacto</a>
                </nav>

            </div>

            <!-- Columna 3: Redes Sociales & Canales Directos -->
            <div class="lg:col-span-4 flex flex-col gap-4">

                <!-- Título Conecta -->
                <span class="text-xs font-mono uppercase text-slate-200 tracking-wider font-semibold">Conecta & Contacto</span>

                <!-- Redes Sociales -->
                <div class="flex flex-wrap items-center gap-2.5">

                    {
                        socialLinks.map((social) => (

                            <a
                                href={social.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={social.name}
                                title={social.name}
                                class="w-9 h-9 rounded-xl bg-slate-900/80 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:border-accent-500/50 hover:bg-slate-800 transition-all duration-300 shadow-sm"
                            >

                                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">

                                    <path d={social.iconSvg} />

                                </svg>

                            </a>

                        ))
                    }

                </div>

                <!-- Botones de Acción Directa -->
                <div class="flex flex-col gap-2 pt-2">

                    <!-- WhatsApp -->
                    <a
                        href="https://wa.me/527205568820?text=%C2%A1Hola%2C%20equipo%20de%20Codeva%20Studio%21%20Estuve%20revisando%20su%20sitio%20web%20y%20me%20gustar%C3%ADa%20platicar%20con%20ustedes%20sobre%20un%20proyecto%20de%20software%20que%20quiero%20desarrollar.%20%C2%BFTienen%20disponibilidad%3F"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-xs font-mono text-emerald-400 hover:text-emerald-300 transition-colors"
                    >

                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span>Iniciar chat por WhatsApp</span>

                    </a>

                    <!-- Gmail / Email -->
                    <a
                        href="mailto:codevastudio.dev@gmail.com"
                        class="inline-flex items-center gap-2 text-xs font-mono text-slate-300 hover:text-accent-400 transition-colors"
                    >

                        <span class="w-2 h-2 rounded-full bg-accent-500"></span>
                        <span>codevastudio.dev@gmail.com</span>

                    </a>

                </div>

            </div>

        </div>

        <!-- Bloque Inferior: Copyright -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">

            <!-- Texto de copyright -->
            <p class="text-center sm:text-left">
                &copy; {currentYear} <span class="text-slate-300 font-medium">Codeva Studio</span>. Todos los derechos reservados.
            </p>

            <!-- Tecnologías usadas -->
            <div class="flex items-center gap-2 font-mono text-[11px] text-slate-500 bg-slate-900/50 px-3 py-1 rounded-lg border border-slate-800/50">

                <span>Construido con</span>
                <span class="text-accent-400">Astro</span>
                <span>&amp;</span>
                <span class="text-cyan-400">Tailwind CSS v4</span>

            </div>

        </div>

    </div>

</footer>