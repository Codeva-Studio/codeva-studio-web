---

<!-- Pie de Página -->
<!--
    Contexto de clas de Tailwind CSS:
    - relative: Posicionamiento relativo para permitir superposición de elementos
    - z-10: Asegura que el pie de página esté por encima de otros elementos
    - border-t: Borde superior para separar visualmente del contenido anterior
    - border-slate-800/80: Color del borde con opacidad para suavizar
    - bg-slate-950/90: Fondo oscuro con opacidad para permitir un ligero efecto de transparencia
    - backdrop-blur-md: Efecto de desenfoque en el fondo para mejorar la legibilidad del contenido
    - text-slate-400: Color del texto
    - font-normal: Fuente con peso normal para el texto 
-->
<footer class="relative z-10 border-t border-slate-800/80 bg-slate-950/90 backdrop-blur-md text-slate-400 font-normal">
    <!-- Contenedor Principal -->
    <!--
        Contexto de clases de Tailwind CSS:
        - max-w-[92rem]: Ancho máximo controlado y consistente con el resto de la web
        - mx-auto: Centrado horizontal
        - px-6 sm:px-10 lg:px-16: Márgenes laterales responsivos
        - py-16: Espacio vertical amplio para separar del contenido anterior y posterior
    -->
    <div class="max-w-[92rem] mx-auto px-6 sm:px-10 lg:px-16 py-16">
        <!-- Bloque Superior Grilla -->
        <!--
            Contexto de clases de Tailwind CSS:
            - grid: Utiliza el sistema de grillas para organizar el contenido
            - grid-cols-1 lg:grid-cols-12: Una columna en pantallas pequeñas y 12 columnas en pantallas grandes
            - gap-10: Espacio entre las columnas
            - items-start: Alinea los elementos al inicio del eje vertical
            - pb-12: Padding inferior para separar del bloque inferior
            - border-b: Borde inferior para separar visualmente del bloque inferior
            - border-slate-800/60: Color del borde con opacidad para suavizar
        -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start pb-12 border-b border-slate-800/60">
            <!-- Columna 1: Brand & Logo (5 columnas) -->
            <!--
                Contexto 
            -->
            <div class="lg:col-span-5 flex flex-col items-start gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-slate-900 border border-slate-800 p-1.5 flex items-center justify-center shrink-0 shadow-inner overflow-hidden">
                        <img 
                            src="/logo.png" 
                            alt="Codeva Studio Logo" 
                            class="w-full h-full object-contain"
                        />
                    </div>
                    
                    <a href="#inicio" class="text-white font-bold text-xl tracking-tight hover:text-purple-400 transition-colors">
                        <span class="text-purple-500 font-mono">&lt;</span>CodevaStudio<span class="text-purple-500 font-mono">/&gt;</span>
                    </a>
                </div>

                <p class="text-xs text-slate-400 max-w-sm leading-relaxed">
                    Estudio boutique de ingeniería y desarrollo de software. Creamos plataformas escalables, sistemas web de alto rendimiento y soluciones digitales a la medida.
                </p>

                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900/80 border border-slate-800/80 text-[11px] font-mono text-emerald-400 mt-1">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Desarrollo Remoto // Global</span>
                </div>
            </div>

            <!-- Columna 2: Navegación Rápida (3 columnas) -->
            <div class="lg:col-span-3 flex flex-col gap-3">
                <span class="text-xs font-mono uppercase text-slate-200 tracking-wider font-semibold">Navegación</span>
                <nav class="flex flex-col gap-2 text-xs font-mono text-slate-400">
                    <a href="#inicio" class="hover:text-purple-400 transition-colors inline-block">// 01. Inicio</a>
                    <a href="#pilares" class="hover:text-purple-400 transition-colors inline-block">// 02. Pilares</a>
                    <a href="#servicios" class="hover:text-purple-400 transition-colors inline-block">// 03. Servicios</a>
                    <a href="#contacto" class="hover:text-purple-400 transition-colors inline-block">// 04. Contacto</a>
                </nav>
            </div>

            <!-- Columna 3: Redes Sociales & Canales Directos (4 columnas) -->
            <div class="lg:col-span-4 flex flex-col gap-4">
                <span class="text-xs font-mono uppercase text-slate-200 tracking-wider font-semibold">Conecta & Contacto</span>
                
                <!-- Redes Sociales -->
                <div class="flex flex-wrap items-center gap-2.5">
                    {
                        socialLinks.map((social) => (
                            <a 
                                href={social.url} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                aria-label={social.name}
                                title={social.name}
                                class="w-9 h-9 rounded-xl bg-slate-900/80 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:border-purple-500/50 hover:bg-slate-800 transition-all duration-300 shadow-sm"
                            >
                                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d={social.iconSvg} />
                                </svg>
                            </a>
                        ))
                    }
                </div>

                <!-- Botones de Acción Directa (WhatsApp y Gmail) -->
                <div class="flex flex-col gap-2 pt-2">
                    <!-- WhatsApp -->
                    <a 
                        href="https://wa.me/527205568820?text=Hola%20Codeva%20Studio,%20me%20interesa%20cotizar%20un%20proyecto" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-xs font-mono text-emerald-400 hover:text-emerald-300 transition-colors"
                    >
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span>WhatsApp Directo &rarr;</span>
                    </a>

                    <!-- Gmail / Email -->
                    <a 
                        href="mailto:codevastudio.dev@gmail.com" 
                        class="inline-flex items-center gap-2 text-xs font-mono text-slate-300 hover:text-purple-400 transition-colors"
                    >
                        <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                        <span>codevastudio.dev@gmail.com</span>
                    </a>
                </div>

            </div>

        </div>

        <!-- Bloque Inferior: Copyright -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
            <p class="text-center sm:text-left">
                &copy; {currentYear} <span class="text-slate-300 font-medium">Codeva Studio</span>. Todos los derechos reservados.
            </p>
            <div class="flex items-center gap-2 font-mono text-[11px] text-slate-500 bg-slate-900/50 px-3 py-1 rounded-lg border border-slate-800/50">
                <span>Construido con</span>
                <span class="text-purple-400">Astro</span>
                <span>&amp;</span>
                <span class="text-cyan-400">Tailwind CSS v4</span>
            </div>
        </div>
    </div>
</footer>