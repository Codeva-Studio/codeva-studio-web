---
// Configuración de los badges de estado y tipo
const badgeOptions = {
    status: {
        completed: {
            label: "Completado",
            style: "bg-green-950 text-green-300",
        },
        inDevelopment: {
            label: "En Desarrollo",
            style: "bg-blue-950 text-blue-300",
        },
        onHold: {
            label: "En Pausa",
            style: "bg-yellow-950 text-amber-300",
        },
        prototype: {
            label: "Prototipo",
            style: "bg-purple-950 text-purple-300",
        },
        planned: {
            label: "Planificado",
            style: "bg-slate-800 text-slate-300",
        },
        cancelled: {
            label: "Cancelado",
            style: "bg-red-950 text-red-300",
        },
    },

    type: {
        personal: {
            label: "Propio",
            style: "bg-slate-800 text-slate-300",
        },
        academic: {
            label: "Académico",
            style: "bg-slate-800 text-slate-300",
        },
        client: {
            label: "Cliente",
            style: "bg-teal-900 text-teal-200",
        },
    },
};

// Tipos permitidos para los proyectos
type ProjectStatus = keyof typeof badgeOptions.status;
type ProjectType = keyof typeof badgeOptions.type;

// Props que recibe la tarjeta de proyecto
interface Props {
    image: string;
    status: ProjectStatus;
    category: string;
    type: ProjectType;
    title: string;
    subtitle: string;
    description: string;
    technologies: string[];
    url?: string;
}

const {
    image,
    status,
    category,
    type,
    title,
    subtitle,
    description,
    technologies,
    url
} = Astro.props;

// Badges dinámicos
const badges = [
    badgeOptions.status[status],
    badgeOptions.type[type],
];

// Comprobamos si el proyecto tiene una URL disponible
const hasUrl = Boolean(url?.trim);
---

<!-- Contenedor principal de la tarjeta de proyecto -->
<article class="relative group z-0 rounded-xl border border-slate-800 bg-gray-900 transition-all duration-300 hover:z-10 hover:border-violet-500/70 hover:shadow-[0_0_0_1px_rgba(139,92,246,0.35),0_0_12px_3px_rgba(139,92,246,0.18),0_0_24px_6px_rgba(139,92,246,0.10)]">

    <!-- Imagen del proyecto -->
    <div class="w-full aspect-[345/185] rounded-t-xl overflow-hidden">
        <img src={image} class="w-full h-full object-contain"/>
    </div>

    <!-- Información del proyecto -->
    <div class="flex flex-1 flex-col gap-2.5 p-4">

        <!-- Badges informativos -->
        <div class="flex flex-nowrap items-start gap-1.5">

            <!-- Estado -->
            <span class={`rounded-md px-2 py-1 text-[10px] font-medium ${badges[0].style}`}>{badges[0].label}</span>

            <!-- Categoría -->
            <span class="rounded-md bg-violet-950 px-2 py-1 text-[10px] font-medium text-violet-300">{category}</span>

            <!-- Tipo de proyecto -->
            <span class={`rounded-md px-2 py-1 text-[10px] font-medium ${badges[1].style}`}>{badges[1].label}</span>
            
        </div>

        <!-- Nombre del proyecto -->
        <h3 class="text-2xl font-bold text-white">{title}</h3>

        <!-- Subtítulo -->
        <p class="text-sm font-normal text-slate-300">{subtitle}</p>

        <!-- Descripción -->
        <p class="text-[13px] font-normal text-slate-400">{description}</p>

        <!-- Tecnologías utilizadas -->
        <div class="mt-2 mb-2 flex flex-nowrap gap-1.5">

            {technologies.map((technology) => (
                <span class="tech-badge text-[11px] font-semibold">{technology}</span>
            ))}

        </div>

        <!-- Enlace al proyecto -->
        {hasUrl ? (

            <a href={url} class="mt-auto flex w-full items-center justify-center rounded-md bg-violet-600 px-4 py-4 font-semibold text-white transition-colors duration-300 hover:bg-violet-700">Ver proyecto</a>
        
        ) : (

            <button type="button" disabled class="mt-auto flex w-full items-center justify-center rounded-md bg-slate-800 px-4 py-4 font-semibold text-slate-400">Ver proyecto</button>
        
        )}

    </div>

</article>
