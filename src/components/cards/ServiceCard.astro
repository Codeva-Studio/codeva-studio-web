---
// Props que recibe la tarjeta de servicio
interface Props {
    title: string;
    description: string;
    technologies: string[];
    iconPath: string;
}

const { title, description, technologies, iconPath} = Astro.props;
---

<!-- Contenedor principal de la tarjeta de servicio -->
<div class="group card-base card-hover flex flex-col justify-between">

    <!-- Resplandor interno sutil en hover -->
    <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-accent-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

    <div>
        <!-- Icono -->
        <div class="icon-box group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <path d={iconPath} />
            </svg>
        </div>

        <!-- Título -->
        <h3 class="text-xl font-bold text-white tracking-tight mb-3 group-hover:text-accent-300 transition-colors duration-300">
            {title}
        </h3>

        <!-- Descripción -->
        <p class="text-slate-400 text-sm leading-relaxed font-normal mb-6">
            {description}
        </p>
    </div>

    <!-- Tecnologías -->
    <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-800/80">

        <!-- Renderizamos una badge por cada tecnologías definido -->
        {
            technologies.map((tech) => (
                <span class="tech-badge">{tech}</span>
            ))
        }
    </div>
</div>
