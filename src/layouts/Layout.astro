---
// Layout base de todas las páginas

// Estilos globales del proyecto
import "../styles/global.css";

// Propiedades que recibe el layout
interface Props {
	title: string;
}

// Extrae las props del layout
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark scroll-smooth">

	<head>

		<!-- Metadatos -->
		<meta charset="UTF-8"/>
		<meta name="description" content="Codeva Studio - Desarrollo de Software & Arquitectura de Alto Rendimiento"/>
		<meta name="viewport" content="width=device-width"/>

		<!-- Favicon del sitio -->
		<link rel="icon" type="image/png" href="/logo.png"/>

		<!-- Fuentes de Google para Inter y Fira Code -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

		<!-- Título de la pestaña, recibido por props -->
		<title>{title}</title>

	</head>

	<!-- Cuerpo de la página que contiene la cuadrícula decorativa y el contenido de cada página -->
	<body class="bg-base text-slate-100 font-sans antialiased min-h-screen selection:bg-accent-500 selection:text-white">

		<!-- Cuadrícula de fondo con degradado progresivo decorativa y no interactiva -->
		<div class="fixed inset-0 bg-[linear-gradient(to_right,#374151_1px,transparent_1px),linear-gradient(to_bottom,#374151_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:linear-gradient(to_bottom,rgba(0,0,0,1)_20%,rgba(0,0,0,0)_90%)] pointer-events-none"></div>

		<!-- Contenido de cada página -->
		<slot />

	</body>

</html>